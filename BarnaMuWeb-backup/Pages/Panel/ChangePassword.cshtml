@page
@model BarnaMu.Web.Pages.Panel.ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="hero hero-small">
    <h1>Cambiar Contraseña</h1>
    <p class="hero-subtitle">La nueva contraseña aplica tanto a la web como al juego.</p>
</div>

<div class="page-narrow">
    @if (Model.Success)
    {
        <div class="alert alert-success">
            <i class="fa fa-check-circle"></i> Contraseña actualizada correctamente. Ya podés usarla en el juego.
        </div>
        <div style="text-align:center;margin-top:12px;">
            <a asp-page="/Panel/Index" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Volver al panel
            </a>
        </div>
    }
    else
    {
        <div class="card">
            <h2>Nueva contraseña</h2>

            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="field">
                    <label asp-for="CurrentPassword">Contraseña actual</label>
                    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" placeholder="Tu contraseña actual" />
                    <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
                </div>

                <div class="field">
                    <label asp-for="NewPassword">Nueva contraseña</label>
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="Mínimo 6 caracteres" />
                    <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirmPassword">Confirmar nueva contraseña</label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Repetí la nueva contraseña" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>

                <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:8px;">
                    <button type="submit" class="btn btn-gold btn-block">
                        <i class="fa fa-lock"></i> Cambiar contraseña
                    </button>
                </div>
            </form>

            <div style="text-align:center;margin-top:16px;">
                <a asp-page="/Panel/Index" style="font-size:12px;color:var(--barna-text-muted);">
                    ← Volver al panel
                </a>
            </div>
        </div>
    }
</div>
