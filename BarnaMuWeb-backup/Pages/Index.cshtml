@page
@model IndexModel
@inject IOptions<BarnaMuOptions> BarnaMuOpts
@{
    ViewData["Title"] = "Inicio";
    var opts = BarnaMuOpts.Value;
    var anyOnline = Model.Status.ConnectServerOnline && Model.Status.GameServersOnline > 0;
    var statusKnown = Model.Status.CheckedAtUtc != DateTime.MinValue;
}

<section class="hero">
    <h1>@opts.ServerName</h1>
    <p class="hero-subtitle">@(string.IsNullOrWhiteSpace(opts.ServerTagline) ? "MU Online Season 6 — server privado con VIP, invasiones y drops balanceados." : opts.ServerTagline)</p>

    <div class="hero-actions">
        <a asp-page="/Register" class="btn btn-gold"><i class="fa fa-user-plus"></i> Crear cuenta</a>
        <a asp-page="/Download" class="btn btn-secondary"><i class="fa fa-download"></i> Descargar cliente</a>
    </div>

    <div class="hero-meta">
        @if (anyOnline) { <span class="pill pill-online">Online</span> }
        @if (!anyOnline && statusKnown) { <span class="pill pill-offline">Offline</span> }
        <span><strong style="color:var(--barna-text-head)">@Model.TotalAccounts</strong> <span class="muted">cuentas</span> · <strong style="color:var(--barna-text-head)">@Model.TotalCharacters</strong> <span class="muted">personajes</span></span>
    </div>
</section>

<div class="grid-2">
    <section class="card">
        <h2>Novedades</h2>
        @if (Model.News.Count == 0)
        {
            <p class="muted">No hay novedades publicadas.</p>
        }
        else
        {
            @foreach (var item in Model.News)
            {
                <article style="margin-bottom:22px;">
                    <h3 style="color:var(--barna-gold-light);font-size:14px;margin-bottom:4px;">@item.Title</h3>
                    <div class="muted" style="font-size:11px;margin-bottom:8px;">@item.Date</div>
                    <div style="font-size:13px;color:var(--barna-text);">@item.Body</div>
                </article>
            }
        }
    </section>

    <section class="card">
        <h2>¿Por qué elegirnos?</h2>
        <ul class="perk-list">
            <li><strong style="color:var(--barna-gold-light)">Cliente Remasterizado HD + 120FPS + 65k max Stats</strong></li>
			<li><strong style="color:var(--barna-gold-light)">Reset lvl 400 - Mantiene Stats</strong></li>
            <li>7 clases — Dark Knight, Dark Wizard, Fairy Elf, Magic Gladiator, Dark Lord, Summoner y Rage Fighter.</li>
            <li><strong style="color:var(--barna-gold-light)">42 Mapas</strong> disponibles desde el primer día.</li>
            <li>Sistema <strong style="color:var(--barna-gold-light)">VIP</strong> con rates diferenciados.</li>
            <li>Comando <code>/offlevel</code> exclusivo para usuarios VIP.</li>
            <li>Sistema de Sockets <code>Seed Sphere</code>.</li>
            <li>Invasiones cada 4h, 6h y 8h — <code>Goldens, Red Dragon, T9 Bosses</code>.</li>
            <li><strong style="color:var(--barna-gold-light)">Anti Pay-To-Win</strong> — no se venden items de ningún tipo.</li>
            <li>Máximo 2 cuentas por IP. MU Helper habilitado.</li>
        </ul>
    </section>
</div>
