@page
@model ForgotPasswordEmailModel
@{
    ViewData["Title"] = "Recuperar por email";
}

<div class="hero hero-small">
    <h1>Recuperar por email</h1>
    <p class="hero-subtitle">Te enviamos un enlace para elegir una nueva contraseña.</p>
</div>

<div class="page-narrow">
    <div class="card">
        @if (Model.Submitted)
        {
            <div class="alert alert-success">
                Si tu cuenta tiene un email registrado, te enviamos un enlace para restablecer
                la contraseña. Revisá tu casilla (y la carpeta de spam). El enlace vence en 1 hora.
            </div>
            <p style="text-align:center;margin-top:18px;font-size:12px;color:var(--barna-text-muted);">
                <a asp-page="/Login">Volver a ingresar</a>
            </p>
        }
        else
        {
            <h2>Enviarme un enlace</h2>
            <p style="font-size:13px;color:var(--barna-text-muted);margin-bottom:18px;">
                Solo funciona si registraste un email en tu cuenta. ¿No tenés email?
                <a asp-page="/ForgotPassword">Recuperá con tu security code</a>.
            </p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="field">
                    <label asp-for="LoginName">Nombre de cuenta</label>
                    <input asp-for="LoginName" type="text" autocomplete="username" placeholder="Tu nombre de usuario" />
                    <span asp-validation-for="LoginName" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn btn-gold btn-block">
                    <i class="fa fa-envelope"></i> Enviarme el enlace
                </button>
            </form>
        }
    </div>
</div>
