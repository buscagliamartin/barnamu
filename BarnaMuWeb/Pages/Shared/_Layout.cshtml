@inject IOptions<BarnaMuOptions> BarnaMuOpts
@{
    var opts      = BarnaMuOpts.Value;
    var page      = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var isLoggedIn = Context.User.Identity?.IsAuthenticated == true;
    var userName  = Context.User.Identity?.Name ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@opts.ServerName — @(ViewData["Title"] ?? "MU Online S6")</title>

    <link rel="stylesheet" href="~/templates/webzen_new/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/templates/default_assets/css/font-awesome.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;900&family=Exo+2:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/barnamed.css" asp-append-version="true" />
</head>
<body class="wz barna-skin">

    <!-- ═══ TOPBAR ═══ -->
    <header class="barna-topbar">
        <div class="barna-topbar__inner">
            <a asp-page="/Index" class="barna-logo">
                <span class="barna-logo__icon">⚔</span>
                <span class="barna-logo__name">@opts.ServerName</span>
                <span class="barna-logo__sub">MU S6</span>
            </a>

            <nav class="barna-nav" id="barnNav">
                <a asp-page="/Index"     class="barna-nav__link @(page == "/Index"     ? "active" : "")">Inicio</a>
                <a asp-page="/Rankings"  class="barna-nav__link @(page == "/Rankings"  ? "active" : "")">Rankings</a>
                <a asp-page="/Vip"       class="barna-nav__link barna-nav__link--vip @(page == "/Vip" ? "active" : "")">VIP</a>
                <a asp-page="/Guide"     class="barna-nav__link @(page == "/Guide"     ? "active" : "")">Guía</a>
                <a asp-page="/Status"    class="barna-nav__link @(page == "/Status"    ? "active" : "")">Estado</a>
                <a asp-page="/Download"  class="barna-nav__link @(page == "/Download"  ? "active" : "")">Descarga</a>
                @if (isLoggedIn)
                {
                    <a asp-page="/Panel/Index" class="barna-nav__link @(page.StartsWith("/Panel") ? "active" : "")">
                        <i class="fa fa-user" style="margin-right:4px;"></i>@userName
                    </a>
                    <form method="post" asp-page="/Logout" style="display:inline;margin:0;">
                        <button type="submit" class="barna-nav__link" style="background:none;border:none;cursor:pointer;padding:6px 10px;color:#8a8580;">
                            Salir
                        </button>
                    </form>
                }
                else
                {
                    <a asp-page="/Login"    class="barna-nav__link @(page == "/Login" ? "active" : "")">Ingresar</a>
                    <a asp-page="/Register" class="barna-nav__link barna-nav__link--cta">Registrarse</a>
                }
            </nav>

            <button class="barna-hamburger" id="barnHam" aria-label="Menú">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <!-- ═══ PAGE WRAPPER ═══ -->
    <div class="barna-page-wrapper">

        <main class="barna-main">
            @RenderBody()
        </main>

        <!-- ═══ SIDEBAR ═══ -->
        <aside class="barna-sidebar">

            <!-- Accesos rápidos -->
            <div class="barna-widget">
                <h4 class="barna-widget__title">Accesos Rápidos</h4>
                <div class="barna-quicklinks">
                    @if (isLoggedIn)
                    {
                        <a asp-page="/Panel/Index"           class="barna-quicklinks__item"><i class="fa fa-user"></i> Mi Panel</a>
                        <a asp-page="/Panel/ChangePassword"  class="barna-quicklinks__item"><i class="fa fa-lock"></i> Cambiar contraseña</a>
                    }
                    else
                    {
                        <a asp-page="/Login"    class="barna-quicklinks__item"><i class="fa fa-user"></i> Ingresar</a>
                        <a asp-page="/Register" class="barna-quicklinks__item"><i class="fa fa-user-plus"></i> Crear cuenta</a>
                    }
                    <a asp-page="/Download"  class="barna-quicklinks__item"><i class="fa fa-download"></i> Descargar cliente</a>
                    <a asp-page="/Vip"       class="barna-quicklinks__item barna-quicklinks__item--vip"><i class="fa fa-star"></i> Obtener VIP</a>
                    <a asp-page="/ReportBug" class="barna-quicklinks__item"><i class="fa fa-bug"></i> Reportar bug</a>
                </div>
            </div>

            <!-- Info servidor -->
            <div class="barna-widget">
                <h4 class="barna-widget__title">Servidor</h4>
                <ul class="barna-info-list">
                    <li><span class="barna-info-list__key">Versión</span><span class="barna-info-list__val">S6 Ep. 3</span></li>
                    <li>
                        <span class="barna-info-list__key">Experiencia</span>
                        <span class="barna-info-list__val">×30 <span class="barna-info-list__val--gold" style="font-size:10px;">/ ×35 VIP</span></span>
                    </li>
                    <li>
                        <span class="barna-info-list__key">Drop</span>
                        <span class="barna-info-list__val">×5 <span class="barna-info-list__val--gold" style="font-size:10px;">/ ×7 VIP</span></span>
                    </li>
                </ul>
            </div>

            <!-- Relojes -->
            <div class="barna-widget">
                <h4 class="barna-widget__title">Horario</h4>
                <div class="barna-clock">
                    <div class="barna-clock__row">
                        <span class="barna-clock__label">Servidor (CEST)</span>
                        <span class="barna-clock__time" id="serverClock">00:00:00</span>
                    </div>
                    <div class="barna-clock__row">
                        <span class="barna-clock__label">Tu hora local</span>
                        <span class="barna-clock__time" id="localClock">00:00:00</span>
                    </div>
                </div>
            </div>

            <!-- Próximos eventos -->
            <div class="barna-widget">
                <h4 class="barna-widget__title">Próximos Eventos</h4>
                <ul class="barna-info-list">
                    <li><span class="barna-info-list__key">Golden Invasion</span><span class="barna-info-list__val barna-info-list__val--gold" id="evGolden">—</span></li>
                    <li><span class="barna-info-list__key">Red Dragon</span><span class="barna-info-list__val barna-info-list__val--gold" id="evDragon">—</span></li>
                    <li><span class="barna-info-list__key">T9 Bosses</span><span class="barna-info-list__val barna-info-list__val--gold" id="evT9">—</span></li>
                    <li><span class="barna-info-list__key">Blood Castle</span><span class="barna-info-list__val barna-info-list__val--gold" id="evBlood">—</span></li>
                    <li><span class="barna-info-list__key">Devil Square</span><span class="barna-info-list__val barna-info-list__val--gold" id="evDevil">—</span></li>
                    <li><span class="barna-info-list__key">Chaos Castle</span><span class="barna-info-list__val barna-info-list__val--gold" id="evChaos">—</span></li>
                </ul>
            </div>

            <!-- Castle Siege -->
            <div class="barna-widget">
                <h4 class="barna-widget__title">Castle Siege</h4>
                <div class="barna-clock" style="padding-top:10px;padding-bottom:12px;">
                    <div class="barna-clock__row" style="margin-bottom:6px;">
                        <span class="barna-clock__label">Próximo Siege</span>
                    </div>
                    <div style="text-align:center;padding:4px 0 6px;">
                        <span id="csSiege" style="font-family:'Cinzel',serif;font-size:1.15rem;font-weight:700;color:var(--barna-gold-light);">—</span>
                    </div>
                    <div class="barna-clock__row">
                        <span style="font-size:10px;color:var(--barna-text-muted);">Sábados · 20:00 CEST</span>
                    </div>
                </div>
            </div>

            <!-- Jugadores online -->
            <div class="barna-widget">
                <h4 class="barna-widget__title">En línea ahora</h4>
                <div style="padding:14px 14px 16px;display:flex;align-items:center;gap:11px;">
                    <span id="onlineDot" style="width:10px;height:10px;border-radius:50%;background:#3dd68c;box-shadow:0 0 8px #3dd68c;flex-shrink:0;display:inline-block;animation:onlinePulse 2s infinite;"></span>
                    <span id="onlineCount" style="font-family:'Cinzel',serif;font-size:1.9rem;font-weight:700;color:var(--barna-gold-light);line-height:1;">—</span>
                    <span style="font-size:11px;color:var(--barna-text-muted);text-transform:uppercase;letter-spacing:0.1em;">jugadores</span>
                </div>
            </div>
            <style>
                @@keyframes onlinePulse {
                    0%,100% { box-shadow: 0 0 6px #3dd68c; }
                    50%      { box-shadow: 0 0 14px #3dd68c, 0 0 24px rgba(61,214,140,0.4); }
                }
            </style>

        </aside>
    </div>

    <!-- ═══ FOOTER ═══ -->
    <footer class="barna-footer">
        <div class="barna-footer__inner">
            <nav class="barna-footer__nav">
                <a asp-page="/Index">Inicio</a>
                <a asp-page="/Rankings">Rankings</a>
                <a asp-page="/Vip">VIP</a>
                <a asp-page="/Guide">Guía</a>
                <a asp-page="/Status">Estado</a>
                <a asp-page="/Download">Descarga</a>
                <a asp-page="/ReportBug">Reportar Bug</a>
            </nav>
            <div class="barna-footer__copy">
                <span>© @DateTime.Now.Year @opts.ServerName</span>
                <span class="barna-footer__sep">·</span>
                <span>MU Online Season 6 Episodio 3</span>
                <span class="barna-footer__sep">·</span>
                <span>Servidor privado — no afiliado a Webzen</span>
            </div>
        </div>
    </footer>

    <script>
        // ── Relojes ──────────────────────────────────────────────────────────
        (function () {
            const pad = n => n < 10 ? '0' + n : n;
            function tick() {
                const now = new Date();
                document.getElementById('localClock').textContent =
                    pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
                const utc = now.getTime() + now.getTimezoneOffset() * 60000;
                const cest = new Date(utc + 3600000 * 2);
                document.getElementById('serverClock').textContent =
                    pad(cest.getHours()) + ':' + pad(cest.getMinutes()) + ':' + pad(cest.getSeconds());
            }
            setInterval(tick, 1000); tick();
        })();

        // ── Eventos ──────────────────────────────────────────────────────────
        (function () {
            // periodH: período en horas, anchorH/anchorM: hora y minuto UTC del primer disparo del día
            function nextFire(periodH, anchorH, anchorM) {
                anchorM = anchorM || 0;
                const now = new Date();
                const periodMs = periodH * 3600000;
                let base = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), anchorH, anchorM, 0)).getTime();
                while (base <= now.getTime()) base += periodMs;
                const diff = base - now.getTime();
                const h = Math.floor(diff / 3600000);
                const m = Math.floor((diff % 3600000) / 60000);
                const s = Math.floor((diff % 60000) / 1000);
                const p = n => String(n).padStart(2, '0');
                return `${p(h)}:${p(m)}:${p(s)}`;
            }
            function updateEvents() {
                document.getElementById('evGolden').textContent = nextFire(4, 0);
                document.getElementById('evDragon').textContent = nextFire(6, 2);
                document.getElementById('evT9').textContent     = nextFire(8, 4);
                document.getElementById('evBlood').textContent  = nextFire(2, 0);       // cada 2h, desde 00:00 UTC
                document.getElementById('evDevil').textContent  = nextFire(2, 1);       // cada 2h, desde 01:00 UTC
                document.getElementById('evChaos').textContent  = nextFire(2, 0, 30);  // cada 2h, desde 00:30 UTC
            }
            setInterval(updateEvents, 1000); updateEvents();
        })();

        // ── Castle Siege countdown ───────────────────────────────────────────
        (function () {
            function nextSiege() {
                const now = new Date();
                // Sábados 20:00 CEST = 18:00 UTC
                const d = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), 18, 0, 0));
                while (d.getUTCDay() !== 6 || d.getTime() <= now.getTime()) {
                    d.setUTCDate(d.getUTCDate() + 1);
                }
                const diff = d.getTime() - now.getTime();
                const days = Math.floor(diff / 86400000);
                const h = Math.floor((diff % 86400000) / 3600000);
                const m = Math.floor((diff % 3600000) / 60000);
                const s = Math.floor((diff % 60000) / 1000);
                const p = n => String(n).padStart(2, '0');
                return days > 0
                    ? `${days}d ${p(h)}:${p(m)}:${p(s)}`
                    : `${p(h)}:${p(m)}:${p(s)}`;
            }
            const el = document.getElementById('csSiege');
            if (el) { setInterval(function () { el.textContent = nextSiege(); }, 1000); el.textContent = nextSiege(); }
        })();

        // ── Online counter (polling) ──────────────────────────────────────────
        // Endpoint esperado: GET /api/online-count → { "count": 42 }
        (function () {
            function pollOnline() {
                fetch('/api/online-count', { cache: 'no-store' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (data) {
                        if (data && data.count !== undefined) {
                            document.getElementById('onlineCount').textContent = data.count;
                        }
                    })
                    .catch(function () {}); // silencioso si el endpoint no existe aún
            }
            setInterval(pollOnline, 30000);
            pollOnline();
        })();

        // ── Hamburger ────────────────────────────────────────────────────────
        (function () {
            const btn = document.getElementById('barnHam');
            const nav = document.getElementById('barnNav');
            if (!btn || !nav) return;
            btn.addEventListener('click', function () {
                const open = nav.classList.toggle('barna-nav--open');
                btn.classList.toggle('barna-hamburger--open', open);
            });
        })();
    </script>
</body>
</html>
