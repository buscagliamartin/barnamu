@page
@model ReportBugModel
@{
    ViewData["Title"] = "Reportar un bug";
}

<div class="card" style="max-width: 720px; margin: 0 auto;">
    <h1>Reportar un bug</h1>
    <p class="muted">Si encontraste algo raro en el servidor (drops, mapas, skills, lag, etc.), contanos lo más detallado posible. Lo leemos.</p>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field">
            <label asp-for="Input.Reporter"></label>
            <input asp-for="Input.Reporter" maxlength="50" />
            <span asp-validation-for="Input.Reporter" class="field-validation-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" type="email" />
            <span asp-validation-for="Input.Email" class="field-validation-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Title"></label>
            <input asp-for="Input.Title" maxlength="120" />
            <span asp-validation-for="Input.Title" class="field-validation-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Body"></label>
            <textarea asp-for="Input.Body" rows="8" maxlength="4000"></textarea>
            <span asp-validation-for="Input.Body" class="field-validation-error"></span>
        </div>

        <button class="btn" type="submit">Enviar reporte</button>
    </form>
</div>
