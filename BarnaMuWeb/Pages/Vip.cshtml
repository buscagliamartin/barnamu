@page
@{
    ViewData["Title"] = "Membresía VIP";
}

<div class="hero hero-small">
    <h1>Membresía VIP</h1>
    <p class="hero-subtitle">Potenciá tu progreso y obtené beneficios exclusivos en el servidor.</p>
</div>

<div class="grid-2">
    <div class="card">
        <h2>¿Cuánto cuesta?</h2>
        <div class="vip-price">USD 10 <span>/ 30 días</span></div>
        <p style="font-size:13px;color:var(--barna-text-muted);margin:14px 0 18px;">
            Pagás por <a href="https://paypal.me/buscagliamartin" target="_blank" style="color:#0070ba;font-weight:700;">PayPal</a>
            y mandás el comprobante por WhatsApp con tu nombre de cuenta.
            Un GM te activa el rango en minutos con el comando <code>/setvip</code>.
        </p>
        <a href="https://wa.me/+34697207339" class="btn btn-gold" style="width:100%;justify-content:center;">
            <i class="fa fa-whatsapp"></i> Contactar soporte
        </a>
        <p style="font-size:11px;color:var(--barna-text-muted);margin-top:12px;text-align:center;">
            Consultá tu tiempo restante con <code>/vipinfo</code> in-game.
        </p>
    </div>

    <div class="card">
        <h2>Beneficios Únicos</h2>
        <ul class="benefit-list">
            <li>Más rates de experiencia, master y drop.</li>
            <li>Almacén (Vault) extendido automáticamente.</li>
            <li><strong>+10%</strong> de éxito en Chaos Machine.</li>
            <li>Comando <code>/offlevel</code> exclusivo.</li>
            <li>Acceso anticipado a mapas de alto nivel.</li>
            <li>Tag <span class="badge-vip">VIP</span> exclusivo en el chat.</li>
        </ul>
    </div>
</div>

<div class="card">
    <h2>Comparativa de Rates</h2>
    <table class="barna-table">
        <thead>
            <tr>
                <th>Concepto</th>
                <th style="text-align:center;">Usuario Normal</th>
                <th style="text-align:center;">Usuario <span class="badge-vip">VIP</span></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Experiencia Base</td>
                <td style="text-align:center;">30×</td>
                <td class="val-gold" style="text-align:center;">35×</td>
            </tr>
            <tr>
                <td>Master Exp</td>
                <td style="text-align:center;">15×</td>
                <td class="val-gold" style="text-align:center;">20×</td>
            </tr>
            <tr>
                <td>Zen Drop</td>
                <td style="text-align:center;">10×</td>
                <td class="val-gold" style="text-align:center;">13×</td>
            </tr>
            <tr>
                <td>Drop General</td>
                <td style="text-align:center;">5%</td>
                <td class="val-gold" style="text-align:center;">7%</td>
            </tr>
            <tr>
                <td>Drop Items Excelentes</td>
                <td style="text-align:center;">~3×</td>
                <td class="val-gold" style="text-align:center;">~4×</td>
            </tr>
        </tbody>
    </table>
</div>
