@page
@{
    ViewData["Title"] = "Membresía VIP";
}

<style>
    .vip-container { max-width: 1000px; margin: 0 auto; padding: 20px; }
    .vip-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; }
    
    .vip-card { background: #111; border: 1px solid #333; border-radius: 8px; padding: 25px; }
    .vip-card h2 { color: #d4af37; margin-top: 0; border-bottom: 1px solid #222; padding-bottom: 10px; font-size: 1.4rem; }
    
    .price-tag { font-size: 2rem; color: #fff; font-weight: bold; margin: 15px 0; }
    .price-tag span { font-size: 1rem; color: #888; }

    .benefit-list { list-style: none; padding: 0; margin: 0; }
    .benefit-list li { padding: 8px 0; border-bottom: 1px solid #1a1a1a; color: #ccc; display: flex; align-items: center; }
    .benefit-list li::before { content: "✔"; color: #d4af37; margin-right: 10px; font-weight: bold; }

    .rate-table { width: 100%; border-collapse: collapse; background: #0f0f0f; border-radius: 8px; overflow: hidden; margin-top: 10px; }
    .rate-table th { background: #161616; padding: 12px; text-align: left; color: #d4af37; border-bottom: 2px solid #222; }
    .rate-table td { padding: 12px; border-bottom: 1px solid #1a1a1a; color: #fff; }
    
    .badge-vip { background: #d4af37; color: #000; padding: 2px 6px; border-radius: 3px; font-weight: bold; font-size: 0.8rem; }
    .command { background: #222; padding: 2px 5px; border-radius: 3px; color: #ff8080; font-family: monospace; }
</style>

<div class="hero hero-small">
    <h1>Membresía VIP</h1>
    <p class="hero-subtitle">Potenciá tu progreso y obtené beneficios exclusivos en el servidor.</p>
</div>

<div class="vip-container">
    <div class="vip-grid">
        <div class="vip-card">
            <h2>¿Cuánto cuesta?</h2>
            <div class="price-tag">USD 10 <span>por 30 días</span></div>
            
			<div style="margin-top: 20px; text-align: center;">
				<p><strong>Cómo comprar:</strong><br>
					Pagás por <a href="https://paypal.me/buscagliamartin" target="_blank" style="color: #0070ba; text-decoration: underline; font-weight: bold;">PayPal</a> 
				y mandás el comprobante por WhatsApp con tu nombre de cuenta.
				Un GM te activa el rango en minutos con el comando <span class="command">/setvip</span>.
				</p>
			</div>
            <div style="margin-top: 20px;">
                <a href="https://wa.me/+34697207339" class="tab-link active" style="display: inline-block; text-align: center;">Contactar Soporte</a>
            </div>
        </div>

        <div class="vip-card">
            <h2>Beneficios Únicos</h2>
            <ul class="benefit-list">
                <li>Más rates en experiencia, master y drop.</li>
                <li>Almacén (Vault) extendido automáticamente.</li>
                <li><strong>+10%</strong> Éxito en Chaos Machine.</li>
                <li>Comando <span class="command">/offlevel</span> exclusivo.</li>
                <li>Acceso anticipado a mapas de alto nivel.</li>
                <li>Tag <span class="badge-vip">VIP</span> exclusivo en el chat.</li>
            </ul>
        </div>
    </div>

    <div class="vip-card">
        <h2>Comparativa de Rates</h2>
        <table class="rate-table">
            <thead>
                <tr>
                    <th>Concepto</th>
                    <th style="text-align: center;">Usuario Normal</th>
                    <th style="text-align: center; color: #d4af37;">Usuario VIP</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Experiencia Base</td>
                    <td style="text-align: center;">30 x</td>
                    <td style="text-align: center; font-weight: bold;">35 x</td>
                </tr>
                <tr>
                    <td>Master Exp</td>
                    <td style="text-align: center;">15 x</td>
                    <td style="text-align: center; font-weight: bold;">20 x</td>
                </tr>
                <tr>
                    <td>Zen Drop</td>
                    <td style="text-align: center;">10 x</td>
                    <td style="text-align: center; font-weight: bold;">13 x</td>
                </tr>
                <tr>
                    <td>Drop General</td>
                    <td style="text-align: center;">5 %</td>
                    <td style="text-align: center; font-weight: bold;">7 %</td>
                </tr>
                <tr>
                    <td>Drop Items Excelentes</td>
                    <td style="text-align: center;">~3 x</td>
                    <td style="text-align: center; font-weight: bold;">~4 x</td>
                </tr>
            </tbody>
        </table>
        <p class="muted-text" style="text-align: center;">
            Consultá tu tiempo restante en tiempo real usando el comando <span class="command">/vipinfo</span> dentro del juego.
        </p>
    </div>
</div>