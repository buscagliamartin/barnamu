@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="hero hero-small">
    <h1>Recuperar contraseña</h1>
    <p class="hero-subtitle">Usá el security code que elegiste al registrarte para definir una nueva contraseña.</p>
</div>

<div class="page-narrow">
    <div class="card">
        @if (Model.Success)
        {
            <div class="alert alert-success">
                Listo. Tu contraseña fue cambiada. Ya podés <a asp-page="/Login">ingresar</a> con la nueva.
            </div>
        }
        else
        {
            <h2>Restablecer mi contraseña</h2>

            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="field">
                    <label asp-for="LoginName">Nombre de cuenta</label>
                    <input asp-for="LoginName" type="text" autocomplete="username" placeholder="Tu nombre de usuario" />
                    <span asp-validation-for="LoginName" class="field-validation-error"></span>
                </div>

                <div class="field">
                    <label asp-for="SecurityCode">Security code</label>
                    <input asp-for="SecurityCode" type="text" inputmode="numeric" autocomplete="off" placeholder="El código numérico de tu registro" />
                    <span asp-validation-for="SecurityCode" class="field-validation-error"></span>
                </div>

                <div class="field">
                    <label asp-for="NewPassword">Nueva contraseña</label>
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirmPassword">Confirmar contraseña</label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn btn-gold btn-block">
                    <i class="fa fa-key"></i> Cambiar contraseña
                </button>
            </form>

            <p style="text-align:center;margin-top:18px;font-size:12px;color:var(--barna-text-muted);">
                ¿Tenés un email en tu cuenta? <a asp-page="/ForgotPasswordEmail">Recuperá por email</a>
            </p>

            <p style="text-align:center;margin-top:6px;font-size:12px;color:var(--barna-text-muted);">
                ¿Te acordaste? <a asp-page="/Login">Volver a ingresar</a>
            </p>
        }
    </div>
</div>
