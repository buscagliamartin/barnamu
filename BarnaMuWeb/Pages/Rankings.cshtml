@page "{mode?}"
@model RankingsModel
@{
    ViewData["Title"] = "Rankings";
}

<div class="hero hero-small">
    <h1>Rankings</h1>
    <p class="hero-subtitle">Top 50 — actualizado en tiempo real con la DB del servidor.</p>
</div>

<div class="bm-rank-toolbar">
    <div class="bm-search">
        <input id="rankSearch" type="text" placeholder="Buscar personaje..." />
        <span>
            <i class="fa fa-search"></i>
        </span>
    </div>
    <span id="rankResultCount" class="bm-search-count"></span>
</div>

<div class="barna-tabs">
    <a asp-page="/Rankings" asp-route-mode="resets" class="barna-tab @(Model.Mode == "resets" ? "active" : "")">Resets</a>
    <a asp-page="/Rankings" asp-route-mode="level"  class="barna-tab @(Model.Mode == "level"  ? "active" : "")">Level</a>
    <a asp-page="/Rankings" asp-route-mode="guilds" class="barna-tab @(Model.Mode == "guilds" ? "active" : "")">Guilds</a>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @Model.Error
    </div>
}
else
{
    <div class="card" style="padding:0;overflow:hidden;">
        @if (Model.Mode == "guilds")
        {
            @if (Model.GuildRows.Count == 0)
            {
                <p class="muted" style="padding:22px 26px;">Todavía no hay guilds creadas.</p>
            }
            else
            {
                <table class="barna-table">
                    <thead>
                        <tr>
                            <th style="width:60px;">#</th>
                            <th>Guild</th>
                            <th style="text-align:center;">Score</th>
                            <th style="text-align:center;">Miembros</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.GuildRows.Count; i++)
                        {
                            var row = Model.GuildRows[i];
                            <tr class="@(i == 0 ? "rank-1" : "")">
                                <td class="rank-num">@(i + 1)</td>
                                <td class="char-name">@row.Name</td>
                                <td class="val-gold" style="text-align:center;">@row.Score.ToString("N0")</td>
                                <td style="text-align:center;">@row.MemberCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="muted" style="font-size:11px;padding:12px 16px;border-top:1px solid var(--barna-border);">Ordenado por <em>Score</em> (Castle Siege / batallas), después por miembros.</p>
            }
        }
        else if (Model.Rows.Count == 0)
        {
            <p class="muted" style="padding:22px 26px;">
                @(Model.Mode == "resets" ? "Todavía no hay personajes con resets." : "Todavía no hay personajes para mostrar.")
            </p>
        }
        else
        {
            <table class="barna-table">
                <thead>
                    <tr>
                        <th style="width:60px;">#</th>
                        <th>Personaje</th>
                        <th style="text-align:center;">@(Model.Mode == "resets" ? "Resets" : "Level")</th>
                        <th style="text-align:center;">@(Model.Mode == "resets" ? "Level" : "Resets")</th>
                        <th style="text-align:center;">Master Lvl</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Rows.Count; i++)
                    {
                        var row = Model.Rows[i];
                        <tr class="@(i == 0 ? "rank-1" : "")">
                            <td class="rank-num">@(i + 1)</td>
                            <td class="char-name">
                                <a asp-page="/Char" asp-route-name="@row.Name"
                                   style="color:inherit;text-decoration:none;"
                                   onmouseover="this.style.color='var(--barna-gold-light)'"
                                   onmouseout="this.style.color='inherit'">@row.Name</a>
                            </td>
                            @if (Model.Mode == "resets")
                            {
                                <td class="val-gold" style="text-align:center;">@row.Resets</td>
                                <td style="text-align:center;">@row.Level</td>
                            }
                            else
                            {
                                <td class="val-gold" style="text-align:center;">@row.Level</td>
                                <td style="text-align:center;">@row.Resets</td>
                            }
                            <td class="val-teal" style="text-align:center;">@row.MasterLevel</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

<script>
    (function () {
        const input = document.getElementById('rankSearch');
        const counter = document.getElementById('rankResultCount');
        if (!input) return;

        input.addEventListener('input', function () {
            const q = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll('.barna-table tbody tr');
            let visible = 0;
            rows.forEach(function (row) {
                const nameCell = row.querySelector('.char-name');
                const match = !q || (nameCell && nameCell.textContent.toLowerCase().includes(q));
                row.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            if (counter) {
                counter.textContent = q
                    ? visible + ' resultado' + (visible !== 1 ? 's' : '')
                    : '';
            }
        });
    })();
</script>
