@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Nueva contraseña";
}

<div class="hero hero-small">
    <h1>Nueva contraseña</h1>
    <p class="hero-subtitle">Elegí una contraseña nueva para tu cuenta.</p>
</div>

<div class="page-narrow">
    <div class="card">
        @if (Model.Success)
        {
            <div class="alert alert-success">
                Listo. Tu contraseña fue cambiada. Ya podés <a asp-page="/Login">ingresar</a> con la nueva.
            </div>
        }
        else if (!Model.TokenValid)
        {
            <div class="alert alert-danger">
                Este enlace no es válido o ya venció. Pedí uno nuevo desde
                <a asp-page="/ForgotPasswordEmail">recuperar por email</a>.
            </div>
        }
        else
        {
            <h2>Definir nueva contraseña</h2>

            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <form method="post">
                <input type="hidden" asp-for="Token" />
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="field">
                    <label asp-for="NewPassword">Nueva contraseña</label>
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirmPassword">Confirmar contraseña</label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn btn-gold btn-block">
                    <i class="fa fa-key"></i> Cambiar contraseña
                </button>
            </form>
        }
    </div>
</div>
