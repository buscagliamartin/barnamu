<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BarnaMu.Web</RootNamespace>
    <UserSecretsId>barnamu-web-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct Postgres + Dapper. The site does NOT reference OpenMU assemblies; it
         shares only the Account table schema and BCrypt password hashing (same package
         version OpenMU uses). This keeps the website self-contained and easy to migrate
         to a separate VPS in the future. -->
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Content\news.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\guide.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
